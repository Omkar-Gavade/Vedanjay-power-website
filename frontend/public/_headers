# Cloudflare (Workers static assets / Pages) headers.
# Lives in the assets root (copied to dist/_headers by Vite) and is read by the
# Cloudflare deploy. Mirrors vercel.json so caching is correct on either host.

# Content-hashed build output — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs and logos change rarely; a month is a safe, generous cache.
/images/*
  Cache-Control: public, max-age=2592000
/gallery/*
  Cache-Control: public, max-age=2592000
/partners/*
  Cache-Control: public, max-age=2592000
/awards/*
  Cache-Control: public, max-age=2592000
/team/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=2592000

# Security headers on every response. HTML keeps its default revalidation, so no
# Cache-Control here — only the safety headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
