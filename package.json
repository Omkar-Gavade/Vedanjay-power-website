{
  "name": "vedanjaypower",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend run build && node scripts/prerender.mjs",
    "dev": "wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "dev:web": "cd frontend && npm run dev -- --port 5180 --strictPort",
    "projects": "node scripts/build-projects.mjs",
    "projects:check": "node scripts/build-projects.mjs --check",
    "notify:test": "node scripts/notify-test.mjs",
    "seo": "node scripts/build-seo.mjs",
    "seo:check": "node scripts/build-seo.mjs --check",
    "prerender": "node scripts/prerender.mjs",
    "atlas": "node scripts/build-asia-dots.mjs",
    "atlas:check": "node scripts/build-asia-dots.mjs --check"
  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "wrangler": "^4.42.0"
  }
}
